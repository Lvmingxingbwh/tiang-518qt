   <property name="styleSheet">
    <string notr="true">/* 设置窗口背景颜色 */
QWidget {
    background-color: #2E3B4E; /* 深蓝色 */
}

/* 设置标题字体样式 */
QLabel#titleLabel, QLabel {
    font-family: &quot;Arial&quot;, sans-serif;
    font-size: 20px;
    color: #ECF0F1; /* 亮灰色 */
    font-weight: bold;
    text-align: center;
background-color: transparent; /* 透明背景 */
}

/* 按钮通用样式 */
QPushButton {
    font-family: &quot;Arial&quot;, sans-serif;
    font-size: 18px;
    color: #FFFFFF; /* 白色字体 */
    background-color: #3498DB; /* 蓝色 */
    border-radius: 5px;
    padding: 10px;
    border: 2px solid #2980B9; /* 深蓝色边框 */
}

/* 鼠标悬停时的按钮样式 */
QPushButton:hover {
    background-color: #2980B9; /* 深蓝色 */
}

/* 按钮被点击时的样式 */
QPushButton:pressed {
    background-color: #1F618D; /* 更深的蓝色 */
}

/* 输入框样式 */
QLineEdit {
    font-family: &quot;Arial&quot;, sans-serif;
    font-size: 18px;
    padding: 5px;
    border: 2px solid #CCCCCC; /* 浅灰色边框 */
    border-radius: 5px;
    background-color: #34495E; /* 深灰色背景 */
    color: #ECF0F1; /* 亮灰色字体 */
}

/* 日志区域样式 */
QTextEdit {
    font-family: &quot;Arial&quot;, sans-serif;
    font-size: 16px;
    padding: 5px;
    border: 2px solid #CCCCCC; /* 浅灰色边框 */
    border-radius: 5px;
    background-color: #34495E; /* 深灰色背景 */
    color: #ECF0F1; /* 亮灰色字体 */
}

/* 设置面板边框 */
QGroupBox {
    border: 2px solid #2980B9; /* 深蓝色边框 */
    border-radius: 5px;
    margin-top: 1ex;
    background-color: #34495E; /* 更深的背景色 */
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 3px;
    color: #ECF0F1; /* 亮灰色 */
    background-color: #2E3B4E; /* 深蓝色背景 */
}
</string>
