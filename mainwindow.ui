    <property name="styleSheet">
     <string notr="true">/* 设置面板边框 */
QGroupBox {
    border: 2px solid #2980B9; /* 深蓝色边框 */
    border-radius: 5px;
    margin-top: 1ex;
    background-color: #34495E; /* 更深的背景色 */
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 3px;
    color: #ECF0F1; /* 亮灰色 */
    background-color: #2E3B4E; /* 深蓝色背景 */
}

/* 设置 QTabWidget 样式 */
QTabWidget::pane {
    border: 1px solid #2980B9; /* 深蓝色边框 */
    background: #34495E; /* 更深的背景色 */
}

QTabBar::tab {
    font-family: &quot;Arial&quot;, sans-serif;
    font-size: 16px;
    color: #ECF0F1; /* 亮灰色字体 */
    background: #2E3B4E; /* 深蓝色背景 */
    padding: 10px;
    border: 1px solid #2980B9; /* 深蓝色边框 */
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
}

QTabBar::tab:selected {
    background: #2980B9; /* 选中的标签背景色 */
    color: #FFFFFF; /* 选中的标签字体颜色 */
}

QTabBar::tab:hover {
    background: #1F618D; /* 悬停的标签背景色 */
}</string>
